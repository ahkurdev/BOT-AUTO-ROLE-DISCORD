# Discord bot token from the Discord Developer Portal (Bot > Token)
DISCORD_TOKEN=

# MongoDB connection string (e.g. mongodb://localhost:27017/self-role-bot)
MONGODB_URI=

# The Discord guild (server) ID where slash commands are registered
GUILD_ID=

# The Discord application (client) ID used to register guild commands
CLIENT_ID=

# Optional: comma-separated DNS servers for Node's resolver (e.g. 8.8.8.8,1.1.1.1).
# Set this only if you get "querySrv ECONNREFUSED" at startup, which happens when
# your network's DNS refuses the SRV lookups that mongodb+srv:// requires.
DNS_SERVERS=

# --- Approval mode (optional) ---
# Set BOTH to enable the approval flow: /role me sends a request to
# APPROVAL_CHANNEL_ID, members holding APPROVER_ROLE_ID press Accept/Reject,
# and the role is granted only on Accept. Leave blank for instant toggle.
APPROVAL_CHANNEL_ID=
APPROVER_ROLE_ID=

# --- Presence / bot status (optional) ---
# Status text. Multiple entries separated by '|' rotate on an interval.
BOT_ACTIVITY=
# Type: Playing | Watching | Listening | Competing (default Playing)
BOT_ACTIVITY_TYPE=
# Status: online | idle | dnd | invisible (default online)
BOT_STATUS=
# Rotation interval in ms, min 15000 (default 30000)
BOT_ACTIVITY_ROTATE_MS=

# --- Auto deploy commands (optional) ---
# Register slash commands automatically on startup (default true). Set to
# "false" to disable and deploy manually with `npm run deploy`.
AUTO_DEPLOY_COMMANDS=
